# Copy this file to ".env" and paste your real token after the "=".
# The .env file is gitignored and must NEVER be committed.
#
# Get a Personal Access Token from YNAB:
#   https://app.ynab.com/settings/developer  ->  New Token
# Reminder: this token grants FULL read/write access to ALL your budgets.
# There is no read-only scope for personal tokens. Keep it secret and local.

YNAB_TOKEN=
